# Node
node_modules/
dist/
*.local
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
venv/

# Env
.env
.env.local

# Assets (generated)
assets/models/*.glb
# scraped retailer images (MinIO in prod)
# NOTE: trailing comments on pattern lines invalidate gitignore rules — keep them on their own line
assets/products/
# per-product batch thumbnails (MinIO in prod)
assets/thumbnails/model_*.png
assets/textures/generated/
assets/qa/
scripts/postgresql-binaries.zip
scripts/pgsql/
scripts/pgdata/
scripts/pg.log
pgsql/

# OS
Thumbs.db
.DS_Store

# Editor
.idea/
.vscode/

# Brochure source PDFs are large binary downloads — fetched on demand,
# never committed (see packages/scraper/brochure_pdf/ docstrings).
assets/brochures/**/*.pdf
assets/brochures/**/extracted/

# scraper caches (category maps, rebuilt per run)
packages/scraper/cache/

# scratch/recon scripts (dev only)
apps/api/_*.py
apps/api/brochure_pdfs_found.json
packages/_debug_*.py
mylife_scrape.log
mylife_models.log
